# ─── Database ───────────────────────────────────────────────────────────────
# For local (non-Docker) setup, create a PostgreSQL database and fill this in.
# Docker users: this is set automatically in docker-compose.yml.
DATABASE_URL=postgresql://postgres:password@localhost:5432/eliseai

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Google Gemini ───────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ─── U.S. Census Bureau ──────────────────────────────────────────────────────
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-api-key

# ─── FRED (Federal Reserve Economic Data) ────────────────────────────────────
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# ─── HUD Fair Market Rents ───────────────────────────────────────────────────
# https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_KEY=your-hud-api-key

# ─── NewsAPI ─────────────────────────────────────────────────────────────────
# https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key

# ─── Tavily (AI web search) ──────────────────────────────────────────────────
# https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key
